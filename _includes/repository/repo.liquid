{% comment %} Metadata is fetched at build time by _plugins/github-repo-metadata.rb {% endcomment %}
{% assign repo_url = include.repository | split: '/' %}
{% assign meta = site.data.github_repo_meta[include.repository] %}

<a
  class="repo-tile"
  href="https://github.com/{{ include.repository }}"
  {% if meta.description %}
    title="{{ meta.description | escape }}"
  {% endif %}
>
  <span class="repo-tile-name">{{ repo_url[1] }}</span>
  {% if meta.language or meta.stars > 0 %}
    <span class="repo-tile-meta">
      {% if meta.language %}
        <span>
          <span
            class="repo-tile-language-dot"
            {% if meta.language_color %}
              style="background-color: {{ meta.language_color }}"
            {% endif %}
          ></span>
          {{- meta.language -}}
        </span>
      {% endif %}
      {% if meta.stars > 0 %}
        <span><i class="fa-regular fa-star"></i> {{ meta.stars }}</span>
      {% endif %}
    </span>
  {% endif %}
</a>
