{% comment %}
  One video on a Persuasive Ads topic page. Called from _layouts/ad_topic.liquid with video=<entry from the page's `videos:` list>.
  An entry has either `youtube:` (a video ID) or `file:` (a path under assets/). See persuasive-ads/climate-change.md for all fields.
{% endcomment %}
{% assign v = include.video %}
<figure class="pa-video">
  <div class="pa-player{% if v.vertical %} pa-player--vertical{% endif %}">
    {% if v.youtube %}
      <button
        type="button"
        class="pa-yt"
        data-pa-youtube="{{ v.youtube | escape }}"
        data-pa-title="{{ v.title | escape }}"
        aria-label="Play {{ v.title | escape }} (loads YouTube)"
      >
        {% if v.poster %}
          <img src="{{ v.poster | relative_url }}" alt="" loading="lazy">
        {% endif %}
        <span class="pa-play" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
        <span class="pa-yt-note">Plays from YouTube</span>
      </button>
    {% elsif v.file %}
      {% assign ext = v.file | split: '.' | last | downcase %}
      <video
        controls
        playsinline
        preload="metadata"
        {% if v.poster %}
          poster="{{ v.poster | relative_url }}"
        {% endif %}
      >
        <source src="{{ v.file | relative_url }}" type="video/{{ ext }}">
        {% if v.captions %}
          <track kind="captions" src="{{ v.captions | relative_url }}" srclang="{{ v.captions_lang | default: 'en' }}" label="Captions" default>
        {% endif %}
      </video>
    {% endif %}
  </div>

  <figcaption class="pa-meta">
    <h3 class="pa-video-title">{{ v.title }}</h3>
    {% if v.description %}
      <p>{{ v.description }}</p>
    {% endif %}
    {% if v.claim %}
      <p><span class="pa-label">Claim</span>{{ v.claim }}</p>
    {% endif %}
    {% if v.strategies %}
      <ul class="pa-chips" aria-label="Persuasion strategies">
        {% for strategy in v.strategies %}
          <li>{{ strategy }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if v.ai_generated or v.source %}
      <p class="pa-source">
        {% if v.ai_generated %}<span class="pa-badge">AI-generated</span>{% endif %}
        {% if v.source %}<span>{{ v.source }}</span>{% endif %}
      </p>
    {% endif %}
  </figcaption>
</figure>
